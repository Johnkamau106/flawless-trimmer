# ========================================
# VIDSLICER CONFIGURATION
# ========================================

# Download timeout in seconds (for long videos)
# Set higher for very long videos (1 hour = 3600s, 2 hours = 7200s)
# Set to 0 for infinite timeout (not recommended for production)
# Default: 3600 (1 hour) - increase if downloading videos longer than 1 hour
VIDSLICER_DOWNLOAD_TIMEOUT=3600

# ========================================
# PERFORMANCE OPTIMIZATION
# ========================================

# Maximum concurrent fragment downloads
# Higher = faster speeds but more CPU/Memory usage
# Recommended: 64-128 for fast speeds, 8 for low-bandwidth
# Default: 32
# VIDSLICER_CONCURRENT_FRAGMENTS=32

# Skip unnecessary FFmpeg processing
# Set to 'true' for fastest speeds (default)
# Set to 'false' if experiencing playback issues
# Default: true
# VIDSLICER_SKIP_VIDEO_PROCESSING=true

# ========================================
# AUTHENTICATION (Optional)
# ========================================

# Method 1: Export cookies from your browser (for YouTube and other sites requiring auth)
# Supported browsers: firefox, chrome, chromium, edge
# VIDSLICER_COOKIES_FROM_BROWSER=firefox

# Method 2: Use pre-exported cookies file
# Download from: https://github.com/x0b/BrowserCookiesQT/releases
# VIDSLICER_COOKIES=/path/to/cookies.txt

# ========================================
# OPTIONAL ADVANCED SETTINGS
# ========================================

# Cache directory for downloaded videos
# VIDSLICER_CACHE_DIR=/tmp/vidslicer_cache

# Enable caching to disk (default: true)
# VIDSLICER_CACHE=true

# Custom database location
# VIDSLICER_DB=/path/to/vidslicer.db

# Custom User-Agent string
# VIDSLICER_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
